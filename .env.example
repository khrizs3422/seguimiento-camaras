# ---------------------------------------------------------------------------
# Variables de entorno opcionales del sistema de seguimiento de camaras.
# Copia este archivo a ".env" y ajusta lo que necesites. Ningun valor es
# obligatorio: todo tiene un valor por defecto razonable en el codigo.
# ---------------------------------------------------------------------------

# --- Camara ---------------------------------------------------------------
# URL RTSP de la camara. Tambien se puede fijar en camera_ai.json.
# Ejemplo: rtsp://usuario:clave@192.168.1.50:554/stream1
CAMARA_RTSP=rtsp://usuario:clave@IP_DE_TU_CAMARA:554/

# --- Servicio local de WhatsApp (whatsapp/whatsapp_alerts.js) --------------
# Direccion del servicio al que el detector le pide enviar las alertas.
WHATSAPP_ALERTS_URL=http://127.0.0.1:8780
# Puerto en el que escucha el servicio de WhatsApp.
WHATSAPP_PORT=8780

# --- Cola de alertas (alertas_whatsapp.py) --------------------------------
# Horas que un aviso sin entregar sigue vigente antes de vencerse.
ALERTA_VIGENCIA_HORAS=24

# --- Puente externo opcional (avanzado) -----------------------------------
# Si dispones de un gateway de WhatsApp aparte que si entrega imagenes a
# grupos, indica aqui su puerto. Si no existe, se usa el envio propio.
PUENTE_EXTERNO_PORT=3000

# --- Tunel para ver la camara de forma remota (puente_camara_puertomontt.py)
# Ruta al ejecutable cloudflared. Si no existe, el puente igual sirve el
# video en la red local.
CLOUDFLARED=C:\Program Files (x86)\cloudflared\cloudflared.exe
